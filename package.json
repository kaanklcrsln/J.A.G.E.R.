{
  "name": "jager",
  "version": "0.1.0",
  "description": "Jager: a JARVIS-style voice agent in a Dynamic Island bar that runs your Mac through Claude Code.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
